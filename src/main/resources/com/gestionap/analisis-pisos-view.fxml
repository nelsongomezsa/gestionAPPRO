<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionap.controller.AnalisisPisosController"
      fx:id="root"
      VBox.vgrow="ALWAYS"
      fillWidth="true"
      styleClass="content-area"
      stylesheets="@styles.css">

    <!-- Cabecera -->
    <VBox styleClass="page-header" spacing="4">
        <Label text="&#128202;  Análisis de Cartera de Pisos" styleClass="page-title"/>
        <Label text="Estado financiero en tiempo real · métricas de rentabilidad por piso" styleClass="page-subtitle"/>
    </VBox>

    <!-- Resumen de cartera — construido programáticamente -->
    <HBox fx:id="boxResumenCartera" spacing="14" fillHeight="true"
          style="-fx-padding: 14 20 4 20; -fx-min-height: 100;"/>

    <!-- Barra de herramientas -->
    <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 8 20 8 20;">
        <Label fx:id="lblUltimaActualizacion"
               text="— cargando —"
               style="-fx-text-fill: #44648a; -fx-font-size: 11px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ProgressIndicator fx:id="progressIndicator" visible="false"
                           prefWidth="24" prefHeight="24"/>
        <Button fx:id="btnActualizar"
                text="&#128260;  Actualizar"
                styleClass="btn-secondary"/>
    </HBox>

    <!-- Lista de tarjetas de pisos -->
    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" fitToHeight="false"
                hbarPolicy="NEVER"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox fx:id="vboxPisos" spacing="14" fillWidth="true"
              style="-fx-padding: 0 20 20 20;" maxWidth="Infinity"/>
    </ScrollPane>

</VBox>
