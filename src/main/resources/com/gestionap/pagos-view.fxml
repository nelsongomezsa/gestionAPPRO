<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionap.controller.PagosController"
      VBox.vgrow="ALWAYS"
      styleClass="content-area"
      stylesheets="@styles.css">

    <VBox styleClass="page-header" spacing="4">
        <Label text="Pagos" styleClass="page-title"/>
        <Label text="Registro de pagos de alquiler" styleClass="page-subtitle"/>
    </VBox>

    <VBox styleClass="content-body" VBox.vgrow="ALWAYS" spacing="14">

        <HBox styleClass="toolbar-row" spacing="10" alignment="CENTER_LEFT">

            <ComboBox fx:id="cmbFiltroInquilino"
                      promptText="Filtrar por inquilino"
                      prefWidth="210" styleClass="combo-box"/>

            <TextField fx:id="txtBuscar"
                       promptText="&#128269;  Buscar..."
                       styleClass="search-field"
                       prefWidth="180"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblMesActual"  text="Este mes: — €" styleClass="total-label"/>
            <Label fx:id="lblTotalPagos" text="Total: — €"    styleClass="total-label"/>

            <Button fx:id="btnEliminarPago"
                    text="&#128465;  Eliminar"
                    styleClass="btn-danger"/>

            <Button fx:id="btnNuevoPago"
                    text="&#43;  Registrar Pago"
                    styleClass="btn-primary"/>

        </HBox>

        <StackPane VBox.vgrow="ALWAYS">
            <TableView fx:id="tablaPagos" styleClass="table-view"
                       maxWidth="Infinity" maxHeight="Infinity">
                <columns>
                    <TableColumn fx:id="colId"        text="ID"        prefWidth="55"/>
                    <TableColumn fx:id="colInquilino" text="INQUILINO" prefWidth="190"/>
                    <TableColumn fx:id="colContrato"  text="CONTRATO"  prefWidth="90"/>
                    <TableColumn fx:id="colCantidad"  text="CANTIDAD"  prefWidth="120"/>
                    <TableColumn fx:id="colMetodo"    text="MÉTODO"    prefWidth="130"/>
                    <TableColumn fx:id="colFecha"     text="FECHA"     prefWidth="120"/>
                </columns>
                <placeholder>
                    <Label text="No hay pagos que mostrar" styleClass="info-label"/>
                </placeholder>
            </TableView>
            <ProgressIndicator fx:id="progressIndicator" visible="false"
                               prefWidth="60" prefHeight="60"/>
        </StackPane>

    </VBox>

</VBox>
