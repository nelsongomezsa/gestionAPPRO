<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionap.controller.DetallePisoController"
      fx:id="root"
      VBox.vgrow="ALWAYS"
      styleClass="content-area"
      stylesheets="@styles.css">

    <!-- Cabecera -->
    <HBox styleClass="page-header" spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnVolver" text="&#8592;  Volver" styleClass="btn-secondary"/>
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTitulo"    text="—" styleClass="page-title"/>
            <Label fx:id="lblSubtitulo" text="—" styleClass="page-subtitle"/>
        </VBox>
        <Button fx:id="btnExportarPdf" text="&#128196;  Exportar PDF" styleClass="btn-primary"/>
    </HBox>

    <!-- KPI cards — construidas programáticamente -->
    <HBox fx:id="boxKpis" spacing="12" style="-fx-padding: 0 20 0 20;"/>

    <!-- Contenido detallado -->
    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="16" style="-fx-padding: 10 20 20 20;">

            <!-- Fila 1: Habitaciones + Gráfico ingresos -->
            <HBox spacing="14">
                <VBox HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Habitaciones" styleClass="page-subtitle"/>
                    <TableView fx:id="tablaHabitaciones" prefHeight="210" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colHabNum"       text="Nº"           prefWidth="50"/>
                            <TableColumn fx:id="colHabEstado"    text="Estado"        prefWidth="110"/>
                            <TableColumn fx:id="colHabPrecio"    text="Precio/mes"    prefWidth="105"/>
                            <TableColumn fx:id="colHabInquilino" text="Inquilino"     prefWidth="170"/>
                            <TableColumn fx:id="colHabFin"       text="Fin contrato"  prefWidth="110"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Ingresos últimos 12 meses" styleClass="page-subtitle"/>
                    <BarChart fx:id="chartIngresos" prefHeight="210" legendVisible="false"
                              animated="false"
                              style="-fx-background-color: transparent; -fx-padding: 0;">
                        <xAxis><CategoryAxis/></xAxis>
                        <yAxis><NumberAxis label="€" minorTickVisible="false"/></yAxis>
                    </BarChart>
                </VBox>
            </HBox>

            <!-- Fila 2: Contratos (ancho completo) -->
            <VBox spacing="6">
                <Label text="Contratos" styleClass="page-subtitle"/>
                <TableView fx:id="tablaContratos" prefHeight="190">
                    <columns>
                        <TableColumn fx:id="colCtHab"       text="Hab."       prefWidth="60"/>
                        <TableColumn fx:id="colCtInquilino" text="Inquilino"  prefWidth="190"/>
                        <TableColumn fx:id="colCtInicio"    text="Inicio"     prefWidth="100"/>
                        <TableColumn fx:id="colCtFin"       text="Fin"        prefWidth="100"/>
                        <TableColumn fx:id="colCtPrecio"    text="Precio/mes" prefWidth="110"/>
                        <TableColumn fx:id="colCtActivo"    text="Estado"     prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Fila 3: Pagos + Incidencias -->
            <HBox spacing="14">
                <VBox HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Últimos pagos" styleClass="page-subtitle"/>
                    <TableView fx:id="tablaPagos" prefHeight="190">
                        <columns>
                            <TableColumn fx:id="colPgFecha"     text="Fecha"     prefWidth="105"/>
                            <TableColumn fx:id="colPgInquilino" text="Inquilino" prefWidth="165"/>
                            <TableColumn fx:id="colPgCantidad"  text="Importe"   prefWidth="100"/>
                            <TableColumn fx:id="colPgMetodo"    text="Método"    prefWidth="110"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Incidencias" styleClass="page-subtitle"/>
                    <TableView fx:id="tablaIncidencias" prefHeight="190">
                        <columns>
                            <TableColumn fx:id="colIncHab"    text="Hab."        prefWidth="50"/>
                            <TableColumn fx:id="colIncFecha"  text="Fecha"       prefWidth="105"/>
                            <TableColumn fx:id="colIncDesc"   text="Descripción" prefWidth="200"/>
                            <TableColumn fx:id="colIncEstado" text="Estado"      prefWidth="105"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>

            <!-- Métricas financieras avanzadas — construidas programáticamente -->
            <VBox fx:id="boxMetricas" spacing="8"/>

        </VBox>
    </ScrollPane>

</VBox>
