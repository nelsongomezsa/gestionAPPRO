<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionap.controller.InquilinosController"
      VBox.vgrow="ALWAYS"
      styleClass="content-area"
      stylesheets="@styles.css">

    <!-- Cabecera -->
    <VBox styleClass="page-header" spacing="4">
        <Label text="Inquilinos" styleClass="page-title"/>
        <Label text="Gestión de inquilinos registrados" styleClass="page-subtitle"/>
    </VBox>

    <!-- Cuerpo -->
    <VBox styleClass="content-body" VBox.vgrow="ALWAYS" spacing="14">

        <!-- Barra de herramientas -->
        <HBox styleClass="toolbar-row" spacing="10" alignment="CENTER_LEFT">

            <TextField fx:id="txtBuscar"
                       promptText="&#128269;  Buscar por nombre o DNI..."
                       styleClass="search-field"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnEditar"
                    text="&#9998;  Editar"
                    styleClass="btn-secondary"/>

            <Button fx:id="btnEliminar"
                    text="&#128465;  Eliminar"
                    styleClass="btn-danger"/>

            <Button fx:id="btnAnadir"
                    text="&#43;  Nuevo Inquilino"
                    styleClass="btn-primary"/>

            <Button fx:id="btnExportarPdf"
                    text="&#128438;  Exportar PDF"
                    styleClass="btn-secondary"/>

            <Button fx:id="btnEnviarEmail"
                    text="&#128140;  Enviar Email"
                    styleClass="btn-secondary"/>

            <Button fx:id="btnQrPago"
                    text="&#128241;  QR Pago"
                    styleClass="btn-secondary"/>

        </HBox>

        <!-- Tabla con overlay de carga -->
        <StackPane VBox.vgrow="ALWAYS">
            <TableView fx:id="tablaInquilinos"
                       maxWidth="Infinity" maxHeight="Infinity"
                       styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colId"        text="ID"        prefWidth="60"/>
                    <TableColumn fx:id="colNombre"    text="NOMBRE"    prefWidth="130"/>
                    <TableColumn fx:id="colApellidos" text="APELLIDOS" prefWidth="150"/>
                    <TableColumn fx:id="colDni"       text="DNI"       prefWidth="110"/>
                    <TableColumn fx:id="colTelefono"  text="TELÉFONO"  prefWidth="120"/>
                    <TableColumn fx:id="colEmail"     text="EMAIL"     prefWidth="200"/>
                </columns>
                <placeholder>
                    <Label text="No hay inquilinos que mostrar" styleClass="info-label"/>
                </placeholder>
            </TableView>
            <ProgressIndicator fx:id="progressIndicator" visible="false"
                               prefWidth="48" prefHeight="48"/>
        </StackPane>

    </VBox>

</VBox>
