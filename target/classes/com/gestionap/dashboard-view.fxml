<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionap.controller.DashboardController"
      VBox.vgrow="ALWAYS"
      styleClass="content-area"
      stylesheets="@styles.css">

    <!-- Cabecera con botón actualizar -->
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Dashboard" styleClass="page-title"/>
            <Label fx:id="lblBienvenida" text="Cargando..." styleClass="page-subtitle"/>
        </VBox>
        <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="28" prefHeight="28"/>
        <Button fx:id="btnActualizar" text="&#128260;  Actualizar" styleClass="btn-secondary"/>
        <Button fx:id="btnInforme"    text="&#128203;  Informe del Mes" styleClass="btn-secondary"/>
    </HBox>

    <!-- Panel de alertas -->
    <HBox fx:id="panelAlertas"
          styleClass="alert-warning-panel"
          spacing="10" alignment="CENTER_LEFT"
          managed="false" visible="false">
        <VBox.margin><Insets top="8" right="30" bottom="0" left="30"/></VBox.margin>
        <Label text="&#9888;" style="-fx-font-size: 18px; -fx-text-fill: #f39c12;"/>
        <Label fx:id="lblAlertasContratos" text=""
               styleClass="alert-warning-label" wrapText="true" HBox.hgrow="ALWAYS"/>
    </HBox>

    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox styleClass="content-body" spacing="24">

            <!-- FILA 1: Habitaciones -->
            <Label text="HABITACIONES" styleClass="page-subtitle"/>
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox styleClass="stat-card, card-purple" spacing="6">
                    <Label text="&#127968;" styleClass="stat-card-icon"/>
                    <Label fx:id="lblTotalHabitaciones" text="—" styleClass="stat-card-value"/>
                    <Label text="TOTAL" styleClass="stat-card-title"/>
                </VBox>
                <VBox styleClass="stat-card, card-green" spacing="6">
                    <Label text="&#9989;" styleClass="stat-card-icon"/>
                    <Label fx:id="lblDisponibles" text="—" styleClass="stat-card-value"/>
                    <Label text="DISPONIBLES" styleClass="stat-card-title"/>
                </VBox>
                <VBox styleClass="stat-card, card-blue" spacing="6">
                    <Label text="&#128273;" styleClass="stat-card-icon"/>
                    <Label fx:id="lblAlquiladas" text="—" styleClass="stat-card-value"/>
                    <Label text="ALQUILADAS" styleClass="stat-card-title"/>
                </VBox>
                <VBox styleClass="stat-card, card-orange" spacing="6">
                    <Label text="&#128295;" styleClass="stat-card-icon"/>
                    <Label fx:id="lblMantenimiento" text="—" styleClass="stat-card-value"/>
                    <Label text="MANTENIMIENTO" styleClass="stat-card-title"/>
                </VBox>
                <!-- Indicador de salud -->
                <VBox styleClass="stat-card" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="&#128202;" styleClass="stat-card-icon"/>
                    <Label fx:id="lblSaludSistema" text="—%"
                           style="-fx-font-size: 32px; -fx-font-weight: bold;"/>
                    <Label text="OCUPACIÓN" styleClass="stat-card-title"/>
                    <Label fx:id="lblSaludTexto" text="" styleClass="stat-card-sub"/>
                </VBox>
            </HBox>

            <!-- FILA 2: Actividad -->
            <Label text="ACTIVIDAD" styleClass="page-subtitle" style="-fx-padding: 8 0 0 0;"/>
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox styleClass="stat-card, card-blue" spacing="6">
                    <Label text="&#128101;" styleClass="stat-card-icon"/>
                    <Label fx:id="lblTotalInquilinos" text="—" styleClass="stat-card-value"/>
                    <Label text="INQUILINOS" styleClass="stat-card-title"/>
                </VBox>
                <VBox styleClass="stat-card, card-teal" spacing="6">
                    <Label text="&#128203;" styleClass="stat-card-icon"/>
                    <Label fx:id="lblContratosActivos" text="—" styleClass="stat-card-value"/>
                    <Label text="CONTRATOS ACTIVOS" styleClass="stat-card-title"/>
                </VBox>
                <VBox styleClass="stat-card, card-green" spacing="6">
                    <Label text="&#128176;" styleClass="stat-card-icon"/>
                    <Label fx:id="lblIngresos" text="—" styleClass="stat-card-value"/>
                    <Label fx:id="lblTrendIngresos" text="" styleClass="stat-card-sub"/>
                    <Label text="COBRADO ESTE MES" styleClass="stat-card-title"/>
                </VBox>
                <VBox styleClass="stat-card, card-red" spacing="6">
                    <Label text="&#9888;" styleClass="stat-card-icon"/>
                    <Label fx:id="lblIncidenciasPendientes" text="—" styleClass="stat-card-value"/>
                    <Label text="INCIDENCIAS PEND." styleClass="stat-card-title"/>
                </VBox>
            </HBox>

            <!-- FILA 3: Próximos vencimientos + Últimas actividades -->
            <HBox spacing="20" alignment="TOP_LEFT" style="-fx-padding: 8 0 0 0;">

                <VBox styleClass="stat-card" spacing="12" HBox.hgrow="ALWAYS">
                    <Label text="PRÓXIMOS VENCIMIENTOS (30 DÍAS)" styleClass="form-section-title"/>
                    <VBox fx:id="vboxVencimientos" spacing="6">
                        <Label text="Cargando..." styleClass="info-label"/>
                    </VBox>
                </VBox>

                <VBox styleClass="stat-card" spacing="12" HBox.hgrow="ALWAYS">
                    <Label text="ÚLTIMAS ACTIVIDADES" styleClass="form-section-title"/>
                    <VBox fx:id="vboxActividades" spacing="6">
                        <Label text="Cargando..." styleClass="info-label"/>
                    </VBox>
                </VBox>

            </HBox>

            <!-- FILA 4: Gráfico de ingresos -->
            <Label text="INGRESOS COBRADOS — ÚLTIMOS 6 MESES" styleClass="page-subtitle"
                   style="-fx-padding: 8 0 0 0;"/>
            <BarChart fx:id="chartIngresos"
                      prefHeight="240"
                      animated="false"
                      legendVisible="false"
                      style="-fx-background-color: transparent;">
                <xAxis><CategoryAxis side="BOTTOM"/></xAxis>
                <yAxis><NumberAxis side="LEFT" autoRanging="true" lowerBound="0" label="€"/></yAxis>
            </BarChart>

        </VBox>
    </ScrollPane>
</VBox>
