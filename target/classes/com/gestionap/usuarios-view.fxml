<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionap.controller.UsuariosController"
      VBox.vgrow="ALWAYS"
      styleClass="content-area"
      stylesheets="@styles.css">

    <VBox styleClass="page-header" spacing="4">
        <Label text="Gestión de Usuarios" styleClass="page-title"/>
        <Label text="Administración de cuentas de acceso al sistema" styleClass="page-subtitle"/>
    </VBox>

    <VBox styleClass="content-body" VBox.vgrow="ALWAYS" spacing="14">

        <HBox styleClass="toolbar-row" spacing="10" alignment="CENTER_LEFT">
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnNuevoUsuario"
                    text="&#43;  Nuevo Usuario"
                    styleClass="btn-primary"/>
            <Button fx:id="btnActivar"
                    text="&#9654;  Activar / Desactivar"
                    styleClass="btn-warning"/>
            <Button fx:id="btnCambiarRol"
                    text="&#128100;  Cambiar Rol"
                    styleClass="btn-secondary"/>
        </HBox>

        <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colId"     text="ID"     prefWidth="60"/>
                <TableColumn fx:id="colNombre" text="NOMBRE" prefWidth="200"/>
                <TableColumn fx:id="colEmail"  text="EMAIL"  prefWidth="240"/>
                <TableColumn fx:id="colRol"    text="ROL"    prefWidth="120"/>
                <TableColumn fx:id="colActivo" text="ESTADO" prefWidth="120"/>
            </columns>
            <placeholder>
                <Label text="No hay usuarios que mostrar" styleClass="info-label"/>
            </placeholder>
        </TableView>

    </VBox>
</VBox>
