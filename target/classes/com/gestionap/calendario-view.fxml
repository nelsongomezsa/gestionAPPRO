<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionap.controller.CalendarioController"
      VBox.vgrow="ALWAYS"
      styleClass="content-area"
      stylesheets="@styles.css">

    <VBox styleClass="page-header" spacing="4">
        <Label text="Calendario de Pagos" styleClass="page-title"/>
        <Label text="Vista mensual de pagos esperados y registrados" styleClass="page-subtitle"/>
    </VBox>

    <VBox styleClass="content-body" VBox.vgrow="ALWAYS" spacing="12">

        <!-- Navegación mes -->
        <HBox alignment="CENTER_LEFT" spacing="16">
            <Button fx:id="btnMesAnterior" text="&lt;  Anterior" styleClass="btn-secondary"/>
            <Label fx:id="lblMesAnio" text="Mayo 2026"
                   style="-fx-text-fill: #e8e8f8; -fx-font-size: 17px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnMesSiguiente" text="Siguiente  &gt;" styleClass="btn-secondary"/>
            <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="22" prefHeight="22"/>
        </HBox>

        <!-- Leyenda + totales -->
        <HBox spacing="18" alignment="CENTER_LEFT">
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="■" style="-fx-text-fill: #2ecc71; -fx-font-size: 13px;"/>
                <Label text="Pagado" style="-fx-text-fill: #8888aa; -fx-font-size: 11px;"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="■" style="-fx-text-fill: #f39c12; -fx-font-size: 13px;"/>
                <Label text="Esperado (días 1-5)" style="-fx-text-fill: #8888aa; -fx-font-size: 11px;"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="■" style="-fx-text-fill: #e74c3c; -fx-font-size: 13px;"/>
                <Label text="Vencido sin cobrar" style="-fx-text-fill: #8888aa; -fx-font-size: 11px;"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotalEsperado" text="Esperado: — €"
                   style="-fx-text-fill: #f39c12; -fx-font-weight: bold; -fx-font-size: 12px;"/>
            <Label fx:id="lblTotalCobrado" text="Cobrado: — €"
                   style="-fx-text-fill: #2ecc71; -fx-font-weight: bold; -fx-font-size: 12px;"/>
            <Label fx:id="lblPendiente" text="Pendiente: — €"
                   style="-fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-font-size: 12px;"/>
        </HBox>

        <!-- Cuadrícula del calendario -->
        <GridPane fx:id="gridCalendario"
                  VBox.vgrow="ALWAYS"
                  hgap="5" vgap="5"/>

    </VBox>

</VBox>
