<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionap.controller.ContratosController"
      VBox.vgrow="ALWAYS"
      styleClass="content-area"
      stylesheets="@styles.css">

    <VBox styleClass="page-header" spacing="4">
        <Label text="Contratos" styleClass="page-title"/>
        <Label text="Gestión de contratos de alquiler" styleClass="page-subtitle"/>
    </VBox>

    <VBox styleClass="content-body" VBox.vgrow="ALWAYS" spacing="14">

        <HBox styleClass="toolbar-row" spacing="10" alignment="CENTER_LEFT">

            <ComboBox fx:id="cmbFiltro"
                      promptText="Mostrar"
                      prefWidth="160" styleClass="combo-box"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnFinalizar"
                    text="&#9209;  Finalizar"
                    styleClass="btn-warning"/>

            <Button fx:id="btnNuevoContrato"
                    text="&#43;  Nuevo Contrato"
                    styleClass="btn-primary"/>

            <Button fx:id="btnExportarPdf"
                    text="&#128438;  PDF"
                    styleClass="btn-secondary"/>

            <Button fx:id="btnGenerarContrato"
                    text="&#128196;  Generar"
                    styleClass="btn-secondary"/>

            <Button fx:id="btnRecordatorio"
                    text="&#128140;  Recordatorio"
                    styleClass="btn-secondary"/>

            <Button fx:id="btnVerEnMapa"
                    text="&#128205;  Mapa"
                    styleClass="btn-secondary"/>

        </HBox>

        <StackPane VBox.vgrow="ALWAYS">
            <TableView fx:id="tablaContratos" styleClass="table-view"
                       maxWidth="Infinity" maxHeight="Infinity">
                <columns>
                    <TableColumn fx:id="colId"             text="ID"          prefWidth="55"/>
                    <TableColumn fx:id="colInquilino"      text="INQUILINO"   prefWidth="170"/>
                    <TableColumn fx:id="colHabitacion"     text="HAB."        prefWidth="65"/>
                    <TableColumn fx:id="colPiso"           text="PISO"        prefWidth="150"/>
                    <TableColumn fx:id="colFechaInicio"    text="INICIO"      prefWidth="100"/>
                    <TableColumn fx:id="colFechaFin"       text="FIN"         prefWidth="100"/>
                    <TableColumn fx:id="colPrecio"         text="€ / MES"     prefWidth="100"/>
                    <TableColumn fx:id="colEstado"         text="ESTADO"      prefWidth="110"/>
                    <TableColumn fx:id="colDiasRestantes"  text="DÍAS REST."  prefWidth="100"/>
                </columns>
                <placeholder>
                    <Label text="No hay contratos que mostrar" styleClass="info-label"/>
                </placeholder>
            </TableView>
            <ProgressIndicator fx:id="progressIndicator" visible="false"
                               prefWidth="60" prefHeight="60"/>
        </StackPane>

    </VBox>

</VBox>
