<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.gestionap.controller.LoginController"
           styleClass="login-root"
           stylesheets="@styles.css"
           prefWidth="900" prefHeight="600">

    <VBox styleClass="login-card" alignment="TOP_CENTER" spacing="13">

        <Label text="&#127968;" styleClass="login-icon"/>
        <Label text="GestionAp" styleClass="login-title"/>
        <Label text="Sistema de Gestión de Alquiler" styleClass="login-subtitle"/>

        <Region prefHeight="12"/>

        <Label text="EMAIL" styleClass="login-field-label" prefWidth="340" alignment="TOP_LEFT"/>
        <TextField fx:id="txtUsuario"
                   promptText="admin@gestionap.com"
                   prefWidth="340"/>

        <Label text="CONTRASEÑA" styleClass="login-field-label" prefWidth="340" alignment="TOP_LEFT"/>
        <PasswordField fx:id="txtPassword"
                       promptText="••••••••"
                       prefWidth="340"/>

        <Label fx:id="lblError"
               styleClass="login-error"
               prefWidth="340"
               wrapText="true"
               visible="false" managed="false"/>

        <Region prefHeight="8"/>

        <Button fx:id="btnLogin"
                text="Iniciar Sesión"
                prefWidth="340"
                styleClass="login-btn"
                defaultButton="true"/>

    </VBox>

</StackPane>
