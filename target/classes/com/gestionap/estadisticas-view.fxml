<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionap.controller.EstadisticasController"
      VBox.vgrow="ALWAYS"
      styleClass="content-area"
      stylesheets="@styles.css">

    <VBox styleClass="page-header" spacing="4">
        <Label text="Estadísticas" styleClass="page-title"/>
        <Label text="Análisis avanzado de rendimiento y ocupación" styleClass="page-subtitle"/>
    </VBox>

    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox styleClass="content-body" spacing="24">

            <!-- KPIs superiores -->
            <HBox spacing="16">
                <VBox styleClass="stat-card, card-green" spacing="6">
                    <Label text="&#128176;" styleClass="stat-card-icon"/>
                    <Label fx:id="lblIngresosAnioActual" text="—" styleClass="stat-card-value"/>
                    <Label fx:id="lblAnioActual" text="INGRESOS AÑO ACTUAL" styleClass="stat-card-title"/>
                </VBox>
                <VBox styleClass="stat-card, card-blue" spacing="6">
                    <Label text="&#128176;" styleClass="stat-card-icon"/>
                    <Label fx:id="lblIngresosAnioAnterior" text="—" styleClass="stat-card-value"/>
                    <Label fx:id="lblAnioAnterior" text="INGRESOS AÑO ANTERIOR" styleClass="stat-card-title"/>
                </VBox>
                <VBox styleClass="stat-card, card-teal" spacing="6">
                    <Label text="&#128202;" styleClass="stat-card-icon"/>
                    <Label fx:id="lblTasaOcupacion" text="—" styleClass="stat-card-value"/>
                    <Label text="TASA DE OCUPACIÓN" styleClass="stat-card-title"/>
                </VBox>
                <VBox styleClass="stat-card, card-purple" spacing="6">
                    <Label text="&#9650;" styleClass="stat-card-icon"/>
                    <Label fx:id="lblVariacion" text="—" styleClass="stat-card-value"/>
                    <Label text="VARIACIÓN ANUAL" styleClass="stat-card-title"/>
                </VBox>
            </HBox>

            <!-- Gráfico de líneas: ingresos 12 meses -->
            <Label text="EVOLUCIÓN DE INGRESOS (12 MESES)" styleClass="page-subtitle"/>
            <LineChart fx:id="chartLineas" prefHeight="240" animated="false" legendVisible="false"
                       style="-fx-background-color: transparent;">
                <xAxis><CategoryAxis side="BOTTOM"/></xAxis>
                <yAxis><NumberAxis side="LEFT" autoRanging="true" lowerBound="0" label="€"/></yAxis>
            </LineChart>

            <!-- Fila inferior: tarta + incidencias -->
            <HBox spacing="20">
                <VBox HBox.hgrow="ALWAYS" spacing="8">
                    <Label text="HABITACIONES POR ESTADO" styleClass="page-subtitle"/>
                    <PieChart fx:id="chartTarta" prefHeight="260" animated="false" legendVisible="true"
                              style="-fx-background-color: transparent;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="8">
                    <Label text="INCIDENCIAS POR MES (6 MESES)" styleClass="page-subtitle"/>
                    <BarChart fx:id="chartIncidencias" prefHeight="260" animated="false" legendVisible="false"
                              style="-fx-background-color: transparent;">
                        <xAxis><CategoryAxis side="BOTTOM"/></xAxis>
                        <yAxis><NumberAxis side="LEFT" autoRanging="true" lowerBound="0"/></yAxis>
                    </BarChart>
                </VBox>
            </HBox>

        </VBox>
    </ScrollPane>
</VBox>
