<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionap.controller.HabitacionesController"
      VBox.vgrow="ALWAYS"
      styleClass="content-area"
      stylesheets="@styles.css">

    <VBox styleClass="page-header" spacing="4">
        <Label text="Habitaciones" styleClass="page-title"/>
        <Label text="Gestión y control de habitaciones" styleClass="page-subtitle"/>
    </VBox>

    <VBox styleClass="content-body" VBox.vgrow="ALWAYS" spacing="14">

        <HBox styleClass="toolbar-row" spacing="10" alignment="CENTER_LEFT">

            <ComboBox fx:id="cmbFiltroEstado"
                      promptText="Filtrar por estado"
                      prefWidth="170" styleClass="combo-box"/>

            <TextField fx:id="txtBuscar"
                       promptText="&#128269;  Buscar inquilino, dirección, ciudad..."
                       styleClass="search-field"
                       prefWidth="270"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnCambiarEstado"
                    text="Cambiar Estado"
                    styleClass="btn-warning"/>

            <Button fx:id="btnEditar"
                    text="&#9998;  Editar"
                    styleClass="btn-secondary"/>

            <Button fx:id="btnEliminar"
                    text="&#128465;  Eliminar"
                    styleClass="btn-danger"/>

            <Button fx:id="btnAnadir"
                    text="&#43;  Nueva Habitación"
                    styleClass="btn-primary"/>

            <Button fx:id="btnExportarPdf"
                    text="&#128438;  PDF"
                    styleClass="btn-secondary"/>

            <Button fx:id="btnVerEnMapa"
                    text="&#128205;  Mapa"
                    styleClass="btn-secondary"/>

        </HBox>

        <StackPane VBox.vgrow="ALWAYS">
            <TableView fx:id="tablaHabitaciones" styleClass="table-view"
                       maxWidth="Infinity" maxHeight="Infinity">
                <columns>
                    <TableColumn fx:id="colId"               text="ID"              prefWidth="55"/>
                    <TableColumn fx:id="colNumero"           text="NÚM."            prefWidth="65"/>
                    <TableColumn fx:id="colEstado"           text="ESTADO"          prefWidth="130"/>
                    <TableColumn fx:id="colPrecio"           text="€ / MES"         prefWidth="110"/>
                    <TableColumn fx:id="colInquilinoActual"  text="INQUILINO ACTUAL" prefWidth="180"/>
                    <TableColumn fx:id="colDias"             text="DÍAS ALQ."       prefWidth="90"/>
                    <TableColumn fx:id="colCiudad"           text="CIUDAD"          prefWidth="110"/>
                    <TableColumn fx:id="colPiso"             text="DIRECCIÓN"       prefWidth="230"/>
                </columns>
                <placeholder>
                    <Label text="No hay habitaciones que mostrar" styleClass="info-label"/>
                </placeholder>
            </TableView>
            <ProgressIndicator fx:id="progressIndicator" visible="false"
                               prefWidth="60" prefHeight="60"/>
        </StackPane>

    </VBox>

</VBox>
